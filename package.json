{
  "name": "rsdi",
  "version": "3.1.0",
  "description": "TypeScript dependency injection container. Strong types without decorators.",
  "scripts": {
    "build": "tsc",
    "test": "vitest --run --typecheck",
    "lint": "eslint && prettier --check . --log-level warn",
    "prepare": "husky",
    "format": "prettier -l --write ."
  },
  "keywords": [
    "dependency injection",
    "dependency",
    "injection",
    "ioc",
    "container",
    "javascript",
    "typescript"
  ],
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "files": [
    "dist/**"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/radzserg/rsdi3",
  "author": "Sergey Radzishevskii <radzserg@gmail.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/utils": "^8.48.1",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "semi": false
  }
}
